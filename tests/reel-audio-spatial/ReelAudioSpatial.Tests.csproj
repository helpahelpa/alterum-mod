<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Same target as the hot assembly, so the linked reel source is compiled under the framework
         the game loads it with. These tests never create a Sound or a channel: they pin the pure
         decisions (which cue an outcome makes, and whether a position may be handed to FMOD). -->
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <RootNamespace>AlterumModelSwap.ReelAudioSpatial.Tests</RootNamespace>
    <AssemblyName>AlterumModelSwap.ReelAudioSpatial.Tests</AssemblyName>
    <!-- ReelDeck.cs is linked whole and its AllowedItems field is filled by ReelEligible at runtime,
         not by an assignment this test assembly can see. -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The same absolute data root the mod's props use (see LAYOUT.md): the game interop refs live
         outside the repository. -p:AlterumDataDir=$HOME/assets/monorepo/alterum-data/ overrides. -->
    <AlterumDataDir Condition="'$(AlterumDataDir)' == ''">$(HOME)/assets/monorepo/alterum-data/</AlterumDataDir>
    <RefsDir Condition="'$(RefsDir)' == ''">$(AlterumDataDir)refs/</RefsDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The production cue code, compiled straight from the mod source: no reimplementation of the
         mapping under test. ReelDeck.g.cs/ReelPool.g.cs come along because ReelAudio names the card
         types (ReelCardType) whose wire byte the settle mapping switches on. -->
    <Compile Include="../../tracks/merged/mod/AlterumModelSwap.Hot/ReelAudio.cs" Link="ReelAudio.cs" />
    <Compile Include="../../tracks/merged/mod/AlterumModelSwap.Hot/ReelDeck.cs" Link="ReelDeck.cs" />
    <Compile Include="../../tracks/merged/mod/AlterumModelSwap.Hot/ReelPool.g.cs" Link="ReelPool.g.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- ReelAudio's signature surface: IHostContext (Contracts), FMOD's types, and UnityEngine's
         Vector3/Mathf. Copied next to the test assembly so the types load when a test touches the
         class; none of them is called. -->
    <ProjectReference Include="../../tracks/merged/mod/AlterumModelSwap.Contracts/AlterumModelSwap.Contracts.csproj" />
    <Reference Include="FMODUnity">
      <HintPath>$(RefsDir)FMODUnity.dll</HintPath>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(RefsDir)Il2CppInterop.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(RefsDir)Il2Cppmscorlib.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RefsDir)UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RefsDir)UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(RefsDir)UnityEngine.AudioModule.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
