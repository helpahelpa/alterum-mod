<Project Sdk="Microsoft.NET.Sdk">
  <!-- Self-contained console harness for NativeModelPolicy: no NuGet packages, no game or Unity
       references, no ProjectReference. It compiles the policy source itself, so the pure decision is
       testable without the mod's interop stack. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>NativeModelPolicyProbe</AssemblyName>
    <RootNamespace>NativeModelPolicyProbe</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The SHIPPING decision, linked not copied: this harness compiles the production file, so a
         policy change cannot pass here while the game runs a different branch. -->
    <Compile Include="../../tracks/merged/mod/AlterumModelSwap.Hot/NativeModelPolicy.cs" Link="NativeModelPolicy.cs" />
  </ItemGroup>
</Project>
