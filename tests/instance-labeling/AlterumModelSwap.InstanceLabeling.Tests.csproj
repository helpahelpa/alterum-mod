<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Same target as the permanent assembly, so the linked guard source is compiled under the
         framework the game will load it with. The tests never touch Win32. -->
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <RootNamespace>AlterumModelSwap.InstanceLabeling.Tests</RootNamespace>
    <AssemblyName>AlterumModelSwap.InstanceLabeling.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The identity rule lives in the permanent guard and stays free of BepInEx/UnityEngine, so
         the test project links that one file instead of dragging in the whole game reference set. -->
    <Compile Include="../../tracks/merged/mod/AlterumModelSwap/InstanceLabelGuard.cs" Link="InstanceLabelGuard.cs" />
  </ItemGroup>
</Project>
