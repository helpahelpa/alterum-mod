<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>AlterumModelSwap.Hot</AssemblyName>
    <RootNamespace>AlterumModelSwap.Hot</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0436;NU1701</NoWarn>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <Import Project="../Alterum.References.props" />
  <!-- After the import on purpose: this group derives from $(AlterumDataDir), which the import
       defines. The binary payload (apack/mset/rset/png) lives outside the repo, in the data tree
       at the mirrored path, and only the .cs/.csproj sources are tracked (see LAYOUT.md).
       -p:AlterumDataDir=... moves $(HotAssetsDir) with it; -p:HotAssetsDir=<dir>/ overrides the
       payload alone (keep the trailing slash). -->
  <PropertyGroup>
    <HotAssetsDir Condition="'$(HotAssetsDir)' == ''">$(AlterumDataDir)tracks/merged/mod/AlterumModelSwap.Hot/</HotAssetsDir>
  </PropertyGroup>
  <ItemGroup>
    <!-- Extracted MoreCompany cosmetic data (see tracks/cosmetics/tools/extract_cosmetics.py).
         Embedded so the normal build+deploy of the hot dll carries the assets atomically. -->
    <EmbeddedResource Include="$(HotAssetsDir)cosmetics.apack" LogicalName="AlterumModelSwap.Hot.cosmetics.apack" />
    <!-- Alterum item-icon sheet for the reel cards: the 51 pool icons the build tool
         (tracks/merged/tools/gen-reel-pool.py with its icons flag) cropped out of the game's own sprite atlases
         and packed into one 768x672 sheet. Regenerated by that script, never edited by hand;
         decoded by PngDecoder at load (ReelArt.LoadPoolIcons) and sliced by the rects in
         ReelPool.g.cs. A live Sprite wins over the sheet when the scene has one loaded. -->
    <EmbeddedResource Include="$(HotAssetsDir)reel_pool_icons.png" LogicalName="AlterumModelSwap.Hot.reel_pool_icons.png" />
    <!-- Sahur body (CC0 1.0, @BakaFoxArt) baked offline by tracks/merged/tools/bake_sahur.py:
         sahur.mset = 8 rigid pieces, int16 positions, uint16 UV, int8 normals, per-vertex bone
         region; sahur_albedo.png = byte copy of the model's own albedo (no material path). -->
    <EmbeddedResource Include="$(HotAssetsDir)sahur.mset" LogicalName="AlterumModelSwap.Hot.sahur.mset" />
    <EmbeddedResource Include="$(HotAssetsDir)sahur_albedo.png" LogicalName="AlterumModelSwap.Hot.sahur_albedo.png" />
    <!-- Wardrobe portraits for the Sahur entry: rendered from the same sahur.mset by
         tracks/merged/tools/sahur_portrait.py (RGBA, transparent), so the icon cannot drift from
         the mesh. sahur_portrait.png = full body, sahur_bust.png = head+shoulders. -->
    <EmbeddedResource Include="$(HotAssetsDir)sahur_portrait.png" LogicalName="AlterumModelSwap.Hot.sahur_portrait.png" />
    <EmbeddedResource Include="$(HotAssetsDir)sahur_bust.png" LogicalName="AlterumModelSwap.Hot.sahur_bust.png" />
    <!-- Rigged variant: "Tung Sahur Game 3D model (Roblox)" by alex.cgwarrior, CC BY 4.0, modified
         (4K maps downscaled, roughness/AO folded into constants, mesh mirrored in X, weights cut to
         4 influences). baked offline by tracks/merged/tools/bake_sahur_roblox.py:
         sahur_roblox.rset = geometry + 4-influence skin + the 71-bone hierarchy (local transforms =
         bind pose) + the authored Mixamo walk clip; albedo/normal are the downscaled PBR maps. -->
    <EmbeddedResource Include="$(HotAssetsDir)sahur_roblox.rset" LogicalName="AlterumModelSwap.Hot.sahur_roblox.rset" />
    <EmbeddedResource Include="$(HotAssetsDir)sahur_roblox_albedo.png" LogicalName="AlterumModelSwap.Hot.sahur_roblox_albedo.png" />
    <EmbeddedResource Include="$(HotAssetsDir)sahur_roblox_normal.png" LogicalName="AlterumModelSwap.Hot.sahur_roblox_normal.png" />
    <!-- Portraits for the rigged entry, rendered from the same rset by
         tracks/merged/tools/sahur_roblox_portrait.py. -->
    <EmbeddedResource Include="$(HotAssetsDir)sahur_roblox_portrait.png" LogicalName="AlterumModelSwap.Hot.sahur_roblox_portrait.png" />
    <EmbeddedResource Include="$(HotAssetsDir)sahur_roblox_bust.png" LogicalName="AlterumModelSwap.Hot.sahur_roblox_bust.png" />
    <!-- ===================== variants2 wardrobe entries =====================
         Everything below is baked by models/variants2/baked/tools/*.py from the three models
         acquired under models/variants2/ (see models/variants2/baked/MANIFEST.md and
         tracks/merged/notes/wardrobe-variants2.md). Each set is one ModelRoster spec:

           "Shpioniro Golubiro" by alex.cgwarrior, CC BY 4.0 - rigid region split (no rig in the
           source), 10 pieces, one 1024^2 albedo.  shpioniro-golubiro.mset / _albedo.png
           "Balerina Capuchino (rigged, game ready)" by alex.cgwarrior, CC BY 4.0 - skinned rig,
           56 bones, 2 materials (Head=0, Body=1) with their own albedo+normal.  balerina-capuchino.rset
           + _albedo_{0,1}.png + _normal_{0,1}.png
           This one is embedded but NOT in the wardrobe roster yet: its bake scales the bone locals
           one normalisation pass too many and the retarget therefore renders it inside out. See
           tracks/merged/notes/wardrobe-variants2.md section 4; re-enable the commented spec in
           ModelRoster.cs after the re-bake. -->
    <EmbeddedResource Include="$(HotAssetsDir)shpioniro-golubiro.mset" LogicalName="AlterumModelSwap.Hot.shpioniro-golubiro.mset" />
    <EmbeddedResource Include="$(HotAssetsDir)shpioniro-golubiro_albedo.png" LogicalName="AlterumModelSwap.Hot.shpioniro-golubiro_albedo.png" />
    <EmbeddedResource Include="$(HotAssetsDir)shpioniro-golubiro_portrait.png" LogicalName="AlterumModelSwap.Hot.shpioniro-golubiro_portrait.png" />
    <EmbeddedResource Include="$(HotAssetsDir)shpioniro-golubiro_bust.png" LogicalName="AlterumModelSwap.Hot.shpioniro-golubiro_bust.png" />
    <EmbeddedResource Include="$(HotAssetsDir)balerina-capuchino.rset" LogicalName="AlterumModelSwap.Hot.balerina-capuchino.rset" />
    <EmbeddedResource Include="$(HotAssetsDir)balerina-capuchino_albedo_0.png" LogicalName="AlterumModelSwap.Hot.balerina-capuchino_albedo_0.png" />
    <EmbeddedResource Include="$(HotAssetsDir)balerina-capuchino_albedo_1.png" LogicalName="AlterumModelSwap.Hot.balerina-capuchino_albedo_1.png" />
    <EmbeddedResource Include="$(HotAssetsDir)balerina-capuchino_normal_0.png" LogicalName="AlterumModelSwap.Hot.balerina-capuchino_normal_0.png" />
    <EmbeddedResource Include="$(HotAssetsDir)balerina-capuchino_normal_1.png" LogicalName="AlterumModelSwap.Hot.balerina-capuchino_normal_1.png" />
    <EmbeddedResource Include="$(HotAssetsDir)balerina-capuchino_portrait.png" LogicalName="AlterumModelSwap.Hot.balerina-capuchino_portrait.png" />
    <EmbeddedResource Include="$(HotAssetsDir)balerina-capuchino_bust.png" LogicalName="AlterumModelSwap.Hot.balerina-capuchino_bust.png" />
