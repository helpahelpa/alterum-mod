  <ItemGroup>
    <!-- Needed to inspect RenderingController._disableKeys (Il2CppSystem.Collections.Generic.HashSet). -->
    <Reference Include="Il2CppSystem.Core">
      <HintPath>$(RefsDir)Il2CppSystem.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- SceneHandle.NetworkSceneLoader.LoadSceneOnServer returns UniTask (spawn.request's `lobby`
         path); the type has to bind, nothing here awaits or starts the player loop from it. -->
    <Reference Include="UniTask">
      <HintPath>$(RefsDir)UniTask.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- SceneHandle.NetworkSceneLoader takes an Eflatun.SceneReference overload; the type has to
         bind for the `lobby` request to compile. Nothing here touches a SceneReference value. -->
    <Reference Include="Eflatun.SceneReference">
      <HintPath>$(RefsDir)Eflatun.SceneReference.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Contracts is provided by the host at runtime; never copy a second copy here. -->
    <ProjectReference Include="../AlterumModelSwap.Contracts/AlterumModelSwap.Contracts.csproj">
      <Private>false</Private>
    </ProjectReference>
    <!-- PlayerModelSetuper._playerModelData is R3.ReactiveProperty<PlayerModelData>; reading its
         .Value is how the wardrobe selection is observed. Interop assembly, never copied. -->
    <Reference Include="R3">
      <HintPath>$(RefsDir)R3.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- RebindActionUI._playerInput is PInput.PlayerInput; the Controls rows have to read and
         re-seat it (the game resolves a row's action through it). Interop assembly, never copied. -->
    <Reference Include="PInput">
      <HintPath>$(RefsDir)PInput.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
