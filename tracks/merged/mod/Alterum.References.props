<Project>
  <PropertyGroup>
    <!-- Source is tracked in this repository. The binary payload (refs, models, installs, dist, shots,
         work) lives OUTSIDE the repository at ~/assets/monorepo/alterum-data/, so a checkout
         stays small and no asset can be committed by accident. See alterum/LAYOUT.md.
         It is absolute on purpose: the data tree is no longer a sibling of this file, so a
         workspace-relative default would silently resolve to nothing in a fresh clone.
         -p:AlterumDataDir=/path/to/alterum-data/ overrides it (keep the trailing slash). -->
    <AlterumDataDir Condition="'$(AlterumDataDir)' == ''">$(HOME)/assets/monorepo/alterum-data/</AlterumDataDir>
    <!-- Override form: -p:AlterumDataDir=$HOME/assets/monorepo/alterum-data/ (absolute, trailing
         slash). Write $HOME, not ~: bash leaves ~ unexpanded inside -p:Name=~/..., and a -p:
         value is a global property that this file cannot rewrite. The check below names the
         resolved path, so a wrong value fails loudly instead of silently embedding nothing. -->
    <RefsDir Condition="'$(RefsDir)' == ''">$(AlterumDataDir)refs/</RefsDir>
  </PropertyGroup>
<ItemGroup>
    <Reference Include="BepInEx.Core">
      <HintPath>$(RefsDir)BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(RefsDir)BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.Common">
      <HintPath>$(RefsDir)BepInEx.Unity.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(RefsDir)0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(RefsDir)Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(RefsDir)Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RefsDir)Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The game ships MagicaCloth2 as an interop assembly; the bone pass only reads its cloth
         state (rootBones / IsValid / IsRunning) and initialises the shipped breast rig if the
         game has not done so yet. -->
    <Reference Include="MagicaClothV2">
      <HintPath>$(RefsDir)MagicaClothV2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RefsDir)UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RefsDir)UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.SceneManagementModule">
      <HintPath>$(RefsDir)UnityEngine.SceneManagementModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule">
      <HintPath>$(RefsDir)UnityEngine.ScreenCaptureModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(RefsDir)UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(RefsDir)UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RefsDir)UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(RefsDir)UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Facepunch.Steamworks.Win64">
      <HintPath>$(RefsDir)Facepunch.Steamworks.Win64.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Netcode.Runtime">
      <HintPath>$(RefsDir)Unity.Netcode.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- FastBufferWriter/Reader carry NativeArray/NativeList overloads, so the compiler needs this
         assembly present even though the bridge only uses the byte* overloads. -->
    <Reference Include="Unity.Collections">
      <HintPath>$(RefsDir)Unity.Collections.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>$(RefsDir)Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(RefsDir)UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(RefsDir)UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(RefsDir)Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Localization">
      <HintPath>$(RefsDir)Unity.Localization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.LocalizationModule">
      <HintPath>$(RefsDir)UnityEngine.LocalizationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- PlayerModelData._modelNameLocalizedString is a UnityEngine.Localization.LocalizedString;
         copying it from the donor to our entry (a null one makes the wardrobe tab's name coroutine
         throw) needs the type to be loadable, which pulls in UIElements' CustomBinding. -->
    <Reference Include="UnityEngine.UIElementsModule">
      <HintPath>$(RefsDir)UnityEngine.UIElementsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(RefsDir)UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Reel of Fortune sound (stub item 4) is synthesised AudioClip.Create samples, and the
         drawn fallback prompt measures with TextAnchor: two module references the merged tree did
         not need before. Additive, Private=false like every other Unity module here. -->
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(RefsDir)UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RefsDir)UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The game's own HUD/notification path for the reel: GameNotifications derives from
         Global.Patterns.Singleton<T> and its ShowNotification carries an FMOD EventReference, so
         both must be resolvable to call it. Additive. -->
    <Reference Include="Patterns">
      <HintPath>$(RefsDir)Patterns.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FMODUnity">
      <HintPath>$(RefsDir)FMODUnity.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Third-person camera: the screen camera is driven by Cinemachine (CameraController holds a
         CinemachineVirtualCameraBase and the first-person eye pose is a vcam), so the offset has to
         be applied through CinemachineCore.CameraUpdatedEvent - after the brain's own push. -->
    <Reference Include="Unity.Cinemachine">
      <HintPath>$(RefsDir)Unity.Cinemachine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Emote playback: the game drives every player rig through Animancer, and the ported
         Lethal Company clips are layered/sampled through Animancer types (track `emotes`). -->
    <Reference Include="Kybernetik.Animancer">
      <HintPath>$(RefsDir)Kybernetik.Animancer.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Kybernetik.Animancer.FSM">
      <HintPath>$(RefsDir)Kybernetik.Animancer.FSM.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Fail loudly if the relative refs path ever stops resolving from this location. -->
  <Target Name="AlterumRefsCheck" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(RefsDir)BepInEx.Core.dll')"
           Text="Alterum refs not found at $(RefsDir); the data tree lives at $(HOME)/assets/monorepo/alterum-data/ - pass -p:AlterumDataDir=... if it is somewhere else." />
  </Target>
</Project>
