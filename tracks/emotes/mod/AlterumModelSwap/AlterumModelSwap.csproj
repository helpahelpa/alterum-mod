<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>AlterumModelSwap</AssemblyName>
    <RootNamespace>AlterumModelSwap</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0436;NU1701</NoWarn>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <Import Project="../Alterum.References.props" />
  <ItemGroup>
    <!-- Must be copied next to the host so the hot assembly can bind to this exact instance. -->
    <ProjectReference Include="../AlterumModelSwap.Contracts/AlterumModelSwap.Contracts.csproj">
      <Private>true</Private>
    </ProjectReference>
  </ItemGroup>
</Project>
